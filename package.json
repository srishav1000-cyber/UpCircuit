{
  "name": "upcircuit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-ocr-assets.mjs && node scripts/sync-instruments.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sync:instruments": "node scripts/sync-instruments.mjs --force",
    "test": "tsx scripts/verify.ts && tsx scripts/verify-auth.ts && tsx --test tests/week10.test.ts tests/fixes.test.ts tests/week11.test.ts tests/daemon-health.test.ts tests/week11-capstone.test.ts tests/week11-final.test.ts tests/week11-polish.test.ts tests/week11-replay.test.ts",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "daemon": "tsx daemon/index.ts",
    "daemon:smoke": "bash scripts/daemon-smoke.sh",
    "bench": "tsx scripts/benchmark-latency.ts --out docs/benchmark-results.json",
    "test:week10": "tsx --test tests/week10.test.ts tests/fixes.test.ts",
    "backtest": "tsx scripts/backtest-heuristics.ts --out public/backtest-heuristics.json",
    "test:week11": "tsx --test tests/week11.test.ts",
    "test:daemon": "tsx --test tests/daemon-health.test.ts",
    "test:capstone": "tsx --test tests/week11-capstone.test.ts",
    "test:final": "tsx --test tests/week11-final.test.ts",
    "test:polish": "tsx --test tests/week11-polish.test.ts",
    "test:replay": "tsx --test tests/week11-replay.test.ts",
    "eod:digest": "tsx scripts/eod-digest.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "jspdf": "^2.5.2",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.454.0",
    "next": "^14.2.15",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "vader-sentiment": "^1.1.3",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  }
}
