# Gemini powers the AI Copilot + Executive sentiment. Without a key, a local VADER/rules engine answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_BASE=            # test-only: point at a mock server

# Comma-separated RSS feeds for the news panel (defaults are built in; unreachable feeds fall back to labelled samples)
# NEWS_RSS_URLS=https://example.com/feed1.xml,https://example.com/feed2.xml

# Instrument master for `npm run sync:instruments` (writes public/data/instruments.json): Angel scrip master (NSE + BSE) + NSE names
# ANGEL_SCRIP_MASTER_URL=https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json
# NSE_EQUITY_CSV_URL=https://nsearchives.nseindia.com/content/equities/EQUITY_L.csv

# ── Live feed (optional) ─────────────────────────────────────────────────────────────────────────
# Web app: URL of the SmartAPI relay (local dev: `npm run relay` → ws://localhost:8787; production: wss://…).
# Set → the browser connects over WS and shows relay prices (LIVE in market hours, "OFF-MARKET · RELAY DATA" after close).
# Unset → "SIMULATED · FEED OFFLINE" / "OFF-MARKET REPLAY". NEXT_PUBLIC_* is inlined at BUILD time: restart `next dev` / rebuild after changing.
NEXT_PUBLIC_FEED_WS_URL=ws://localhost:8787

# Relay fallback: with no SMARTAPI_* set (or SmartAPI down / silent) the relay streams Yahoo Finance quotes (SYMBOL.NS, else .BO) — pill shows LIVE FEED.
# YAHOO_POLL_MS=6000
# YAHOO_MAX_SYMBOLS=30

# Relay process (`npm run relay`; needs a long-lived host — NOT Vercel serverless). Credentials never reach the browser.
# SMARTAPI_API_KEY=
# SMARTAPI_CLIENT_CODE=
# SMARTAPI_PASSWORD=
# SMARTAPI_TOTP_SECRET=
# RELAY_PORT=8787
# RELAY_ALLOWED_ORIGIN=https://your-app.vercel.app

# ── accounts ──
# Unset → browser-only demo accounts (PBKDF2 in localStorage; NOT secure). Set both → Supabase Auth + docs/AUTH_SCHEMA.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# false → skip the login wall (guest, Full Access, shared storage)
NEXT_PUBLIC_AUTH_REQUIRED=true
# Public relay (BUILD-time variable, must be wss:// on an https site):  NEXT_PUBLIC_FEED_WS_URL=wss://upcircuit-relay.onrender.com
# The relay honours PORT automatically (Render / Railway / Fly) and RELAY_ALLOWED_ORIGIN may list several origins, comma-separated.
