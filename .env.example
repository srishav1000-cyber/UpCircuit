# Gemini powers the AI Copilot + Executive sentiment. Without a key, a local VADER/rules engine answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_BASE=            # test-only: point at a mock server

# Comma-separated RSS feeds for the news panel (defaults are built in; unreachable feeds fall back to labelled samples)
# NEWS_RSS_URLS=https://example.com/feed1.xml,https://example.com/feed2.xml

# Instrument master for `npm run sync:instruments` (writes public/data/instruments.json): Angel scrip master (NSE + BSE) + NSE names
# ANGEL_SCRIP_MASTER_URL=https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json
# NSE_EQUITY_CSV_URL=https://nsearchives.nseindia.com/content/equities/EQUITY_L.csv

# ── Live feed (optional) — the BROWSER connects straight to Angel One's socket; there is no relay server ─────────────────
# Server-side secrets (Vercel env vars, never exposed): used by /api/smartapi/session to log in; only the feed token + client code reach the browser.
# SMARTAPI_API_KEY=
# SMARTAPI_CLIENT_CODE=
# SMARTAPI_PASSWORD=
# SMARTAPI_TOTP_SECRET=
# Browser-side (BUILD-time, public): the same API key, needed to open wss://smartapisocket.angelone.in/smart-stream.
# Unset → the app runs on real, delayed last-session data (badge "● OFFLINE SESSION (LAST NSE CLOSE)" off-hours).
NEXT_PUBLIC_SMARTAPI_API_KEY=
# Without Supabase accounts the session endpoint refuses (it would hand the owner's feed token to anyone). Private deployments only:
# SMARTAPI_SESSION_PUBLIC=1

# ── accounts ──
# Unset → browser-only demo accounts (PBKDF2 in localStorage; NOT secure). Set both → Supabase Auth + docs/AUTH_SCHEMA.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# false → skip the login wall (guest, Full Access, shared storage)
NEXT_PUBLIC_AUTH_REQUIRED=true

# ── public URL (every redirect / e-mail link resolves from this; default https://upcircuit.vercel.app) ──
NEXT_PUBLIC_APP_URL=https://upcircuit.vercel.app

# ── tick persistence + off-market replay (server-side only) — run docs/MARKET_TICKS.sql first ──
# Service-role key: used ONLY by /api/market/{ticks,replay,export-csv}. Never expose it to the browser (no NEXT_PUBLIC_ prefix).
# SUPABASE_SERVICE_ROLE_KEY=

# ── circuit-alert e-mail (server-side only; sent to the signed-in Supabase user's own address) ──
# RESEND_API_KEY=
# EMAIL_FROM=UpCircuit <alerts@yourdomain.com>

# --- Round 29: cloud sync / PWA / web push ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://upcircuit.vercel.app
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional extra push-endpoint hosts (comma separated)
PUSH_ENDPOINT_ALLOW=
